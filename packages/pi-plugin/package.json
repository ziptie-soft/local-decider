{
  "name": "@ziptie-soft/pi-local-decider",
  "version": "1.0.1",
  "description": "pi extension for local-decider: guards tool calls and, optionally, approves routine ones, using a local decision model.",
  "keywords": [
    "ai-agents",
    "coding-agents",
    "decision-model",
    "local-decider",
    "local-llm",
    "permissions",
    "pi",
    "pi-package"
  ],
  "homepage": "https://github.com/ziptie-soft/local-decider/tree/master/packages/pi-plugin#readme",
  "bugs": {
    "url": "https://github.com/ziptie-soft/local-decider/issues"
  },
  "license": "Apache-2.0",
  "author": "ziptie-soft",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ziptie-soft/local-decider.git",
    "directory": "packages/pi-plugin"
  },
  "files": [
    "extension/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE"
  ],
  "type": "module",
  "scripts": {
    "build": "pnpm run typecheck",
    "test": "node --test --import ../../scripts/test-tmpdir.mjs --conditions=source 'test/**/*.test.ts'",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@ziptie-soft/local-decider-core": "workspace:*"
  },
  "engines": {
    "node": ">=24.15"
  },
  "localDecider": {
    "gateway": "3.2.0"
  },
  "pi": {
    "extensions": [
      "./extension/index.ts"
    ],
    "image": "https://raw.githubusercontent.com/ziptie-soft/local-decider/master/docs/assets/social-preview.png"
  }
}
